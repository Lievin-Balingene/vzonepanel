# Packages
*.tar
*.zip
*.gzip
*.gz
*.bz2
*.deb

# Editors
.vs/
.nova/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
nbproject/project.properties
nbproject/project.xml

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

.env

# Distribution CSS — track compiled themes so VPS installs work without a local build
# (source remains in web/css/src/)
web/css/themes/custom/
!web/css/themes/
!web/css/themes/*.min.css
!web/css/themes/*.min.css.map

# Distribution JS — track compiled bundles for VPS deploys
web/js/dist/**
!web/js/dist/
!web/js/dist/*.min.js
!web/js/dist/*.min.js.map

# Composer
composer.phar
test/vendor/
# PHPMailer
web/inc/vendor/
# Quick install
web/src/vendor/
.phpunit.result.cache

# vitepress build output
**/.vitepress/dist/
**/.vitepress/cache/
# Node
**/node_modules/
npm-debug.log
